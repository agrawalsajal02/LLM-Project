# Copy to .env (repo root for Docker Compose, or backend/.env for local dev) and fill in.
# Everything here has a free option; see FREE_TIER_GUIDE.md.

# ---- LLM ----
# "gemini" for real answers, "fake" to try the app without an API key.
LLM_PROVIDER=gemini
# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite

# Used for local dev only; Docker Compose overrides it.
DATABASE_URL=postgresql+asyncpg://chat:chat@localhost:5432/chat
CORS_ORIGINS=["http://localhost:3000"]
HISTORY_MAX_MESSAGES=20

# ---- Phase 2: documents + RAG ----
# "gemini" (free tier), "local" (CPU, pip install -r requirements-local-models.txt), "fake"
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768
# If you switch embedding provider/dims, delete the index and re-upload documents.

# "elasticsearch" or "memory" (no extra service, small data only)
SEARCH_BACKEND=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
# "local" (pypdf / python-docx) or "tika" (docker compose --profile tika up)
PARSER=local
RETRIEVAL_TOP_K=5
# "none" or "local" (bge-reranker cross-encoder on CPU, needs requirements-local-models.txt)
RERANKER=none

# ---- Phase 3: agent ----
# "agent" (planner decides) or "rag" (always search documents, Phase 2 behaviour)
CHAT_MODE=agent
# "none", "tavily" (free credits, https://tavily.com) or "searxng" (docker compose --profile websearch up)
WEB_SEARCH_PROVIDER=none
TAVILY_API_KEY=
SEARXNG_URL=http://localhost:8080

MCP_ENABLED=true
# Optional: send create_ticket to Jira (free plan) instead of the local tickets table
# JIRA_URL=https://your-site.atlassian.net
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT=OPS
